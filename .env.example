APP_NAME=YAdmin
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0
# 留空时自动使用 APP_NAME 作为 Redis 键前缀；仅在需要覆盖时设置。
# REDIS_PREFIX=skeleton:

MESSAGE_REDIS_TTL=2592000
MESSAGE_MAX_HISTORY=500
MESSAGE_WS_TICKET_TTL=60

JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=1209600
JWT_ALGO=HS512
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
